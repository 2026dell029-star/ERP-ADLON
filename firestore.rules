rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schools collection (Multi-school creation, selection and management)
    match /schools/{schoolId} {
      allow read, write: if true;

      // School-specific scoped collections
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Settings collection (School parameters, fees, branding)
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Students collection (Enrollment, grades, finances, payments)
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Staff members collection (Payroll, roles, contacts)
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Audit logs collection (Read-only history, append-only logs)
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Users collection (User profiles and preferences)
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
