rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default deny all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Settings collection (School parameters, fees, branding)
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId);
    }

    // Students collection (Enrollment, grades, finances, payments)
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(studentId)
        && request.resource.data.matricule is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string;
      allow update: if isSignedIn() && isValidId(studentId);
      allow delete: if isSignedIn() && isValidId(studentId);
    }

    // Staff members collection (Payroll, roles, contacts)
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(staffId)
        && request.resource.data.name is string
        && request.resource.data.role is string;
      allow update: if isSignedIn() && isValidId(staffId);
      allow delete: if isSignedIn() && isValidId(staffId);
    }

    // Audit logs collection (Read-only history, append-only logs)
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId)
        && request.resource.data.action is string;
      allow update, delete: if false; // Immutable audit trail
    }

    // Users collection (User profiles and preferences)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
